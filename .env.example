# Every variable is optional: the app builds and runs with an empty environment.

# Data layer: mock (default). Backend phase adds: supabase
# With mock data on a production deployment (VERCEL_ENV=production) the admin sign-in is off (D19).
DATA_SOURCE=mock

# Mock clock: ISO date-time, or "real". Default: the canvas moment 2026-10-04T18:18+02:00
# MOCK_NOW=real

# Clone list fixtures N times (dev only) to check pagination
# MOCK_MULTIPLY=8

# Comma-separated feature flags to switch on: phase2, memoriesMap, eestecSso, adminSearch, adminNotifications
# FEATURE_FLAGS=phase2

# Show /design-system and /admin/design-system under `next start` (it is always on in `next dev` and Vercel previews, never in production)
# ENABLE_DEV_SURFACES=true

# Canonical site URL (falls back to the Vercel production URL, then localhost)
# NEXT_PUBLIC_SITE_URL=https://eestec.mk

# Optional Cloudflare Turnstile (invisible spam check); honeypot + timing work without it
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
